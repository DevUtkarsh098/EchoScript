// Configure this as a separate, restricted Pipeline-from-SCM job on reviewed giri.
// Never grant PR jobs this label, OIDC token, backend mounts, or approval permission.
properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '20')),
    parameters([
        choice(name: 'ACTION', choices: ['validate', 'deploy', 'rollback'], description: 'Production changes require the saved-plan approval below.'),
        string(name: 'ROLLBACK_SHA', defaultValue: '', description: 'Full previous immutable release SHA; used only for rollback.')
    ])
])
node('echoscript-release') {
    checkout scm
    def flow = load 'ci/pipeline.groovy'
    try {
        if (env.CHANGE_ID || env.CHANGE_URL) { error('PR builds cannot enter the release job.') }
        sh 'mkdir -p ci-artifacts ci-private; chmod 700 ci-private; git rev-parse HEAD > ci-artifacts/source-commit.txt'
        env.SOURCE_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
        env.IMAGE_TAG = params.ACTION == 'rollback' ? params.ROLLBACK_SHA.trim() : env.SOURCE_SHA
        flow.validate()
        if (params.ACTION != 'validate') {
            if (!env.RELEASE_APPROVERS || !env.TF_PLAN_RECIPIENT) {
                error('Configure named Jenkins approvers and the public age recipient before production work.')
            }
            stage('Verify reviewed release source') {
                sh 'test -r "$SMOKE_TOKEN_FILE"; test -r "$SMOKE_AUDIO_FILE"'
                sh 'git fetch origin giri; test "$(git rev-parse origin/giri)" = "$SOURCE_SHA"'
                sh 'bash ci/scripts/release.sh verify-tag'
            }
            if (params.ACTION == 'deploy') {
                stage('Publish scanned immutable images') {
                    flow.awsRole('JENKINS_PUBLISH_ROLE_ARN') { sh 'bash ci/scripts/release.sh publish' }
                }
            }
            stage('Generate and archive protected Terraform plan') {
                flow.awsRole('JENKINS_PLAN_ROLE_ARN') {
                    sh 'bash ci/scripts/terraform-init.sh'
                    sh(params.ACTION == 'rollback' ? 'bash scripts/deploy-frontend.sh prepare-rollback "$IMAGE_TAG"' : 'bash scripts/deploy-frontend.sh prepare "$IMAGE_TAG"')
                    sh 'bash ci/scripts/terraform-plan.sh'
                }
                flow.archiveEvidence()
            }
            stage('Explicit production approval') {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "Review plan-summary.json and encrypted saved plan for ${env.IMAGE_TAG}. Apply to existing account 598391748654/us-west-2?",
                          ok: 'Apply reviewed saved plan', submitter: env.RELEASE_APPROVERS
                }
            }
            stage('Apply the same saved plan') {
                flow.awsRole('JENKINS_DEPLOY_ROLE_ARN') { sh 'bash ci/scripts/release.sh apply' }
            }
            stage('Publish or restore immutable frontend bundle') {
                flow.awsRole('JENKINS_FRONTEND_ROLE_ARN') {
                    sh(params.ACTION == 'rollback' ? 'bash scripts/deploy-frontend.sh rollback "$IMAGE_TAG"' : 'bash scripts/deploy-frontend.sh deploy "$IMAGE_TAG"')
                }
            }
            stage('Health and authenticated transcription acceptance') {
                flow.awsRole('JENKINS_SMOKE_ROLE_ARN') { sh 'python3 ci/scripts/smoke.py' }
            }
        }
    } finally {
        // ci-private contains plaintext plans and presigned URLs. Never archive it.
        flow.archiveEvidence()
        sh 'python3 ci/scripts/clean-private.py'
    }
}

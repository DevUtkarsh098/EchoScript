pipeline {
  agent any
  options { timestamps(); disableConcurrentBuilds() }
  stages {
    stage('Secret scan') { steps { sh 'bash ci/scripts/scan-secrets.sh' } }
    stage('Validate manifests') { steps { sh 'kubectl apply --dry-run=client -f infrastructure/kubernetes/' } }
    stage('Build workers') { steps { sh 'docker build -t transcribe-worker:${GIT_COMMIT} services/transcribe-worker'; sh 'docker build -t video-service:${GIT_COMMIT} services/video-service'; sh 'trivy image --exit-code 1 --ignorefile= --severity HIGH,CRITICAL transcribe-worker:${GIT_COMMIT}'; sh 'trivy image --exit-code 1 --ignorefile= --severity HIGH,CRITICAL video-service:${GIT_COMMIT}' } }
    stage('Deploy runtime') { steps { sh 'kubectl apply -f infrastructure/kubernetes/monitoring'; sh './ci/scripts/deploy-runtime.sh ${GIT_COMMIT}' } }
    stage('Smoke') { steps { sh './scripts/smoke-test.sh' } }
  }
}


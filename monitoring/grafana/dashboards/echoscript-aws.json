{
  "title": "EchoScript AWS Operations",
  "uid": "echoscript-aws-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API metrics target",
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"echoscript-api\"}",
          "legendFormat": "API"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active jobs",
      "targets": [
        {
          "refId": "A",
          "expr": "echoscript_active_jobs{job=\"echoscript-api\"}",
          "legendFormat": "active"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job submissions / second",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(echoscript_job_submissions_total{job=\"echoscript-api\"}[5m])",
          "legendFormat": "submissions/s"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API latency p95",
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(echoscript_http_request_duration_seconds_bucket{job=\"echoscript-api\",route!=\"/metrics\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 16,
        "h": 8
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "API process memory",
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"echoscript-api\"} / 1024 / 1024",
          "legendFormat": "MiB"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 7,
        "w": 8,
        "h": 5
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Prometheus scrape duration",
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{job=\"echoscript-api\"}",
          "legendFormat": "seconds"
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 5
      }
    }
  ]
}

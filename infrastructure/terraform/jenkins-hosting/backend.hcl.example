# Use the CONFIRMED EXISTING state bucket/lock table; never copy the application's key here.
bucket         = "CONFIRM_EXISTING_STATE_BUCKET_WITH_ADMINISTRATOR"
key            = "echoscript/jenkins-hosting/terraform.tfstate"
region         = "us-west-2"
encrypt        = true
dynamodb_table = "CONFIRM_EXISTING_LOCK_TABLE_WITH_ADMINISTRATOR"

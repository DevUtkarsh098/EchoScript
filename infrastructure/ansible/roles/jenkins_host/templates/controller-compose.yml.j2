services:
  jenkins:
    image: echoscript-jenkins-controller:2.580.2-lts
    build:
      context: /opt/echoscript-jenkins
      dockerfile: Dockerfile
    container_name: echoscript-jenkins
    restart: unless-stopped
    user: "1000:1000"
    environment:
      CASC_JENKINS_CONFIG: /var/jenkins_config/jenkins.yml
      JENKINS_ADMIN_ID: ${JENKINS_ADMIN_ID:?controller bootstrap secret missing JENKINS_ADMIN_ID}
      JENKINS_ADMIN_PASSWORD: ${JENKINS_ADMIN_PASSWORD:?bootstrap secret missing}
      GITHUB_TOKEN: ${GITHUB_TOKEN:?controller bootstrap secret missing GITHUB_TOKEN}
      PR_VALIDATOR_ID: ${PR_VALIDATOR_ID:?controller bootstrap secret missing PR_VALIDATOR_ID}
      PR_VALIDATOR_PASSWORD: ${PR_VALIDATOR_PASSWORD:?controller bootstrap secret missing PR_VALIDATOR_PASSWORD}
      RELEASE_OPERATOR_ID: ${RELEASE_OPERATOR_ID:?controller bootstrap secret missing RELEASE_OPERATOR_ID}
      RELEASE_OPERATOR_PASSWORD: ${RELEASE_OPERATOR_PASSWORD:?controller bootstrap secret missing RELEASE_OPERATOR_PASSWORD}
      RELEASE_APPROVER_ID: ${RELEASE_APPROVER_ID:?controller bootstrap secret missing RELEASE_APPROVER_ID}
      RELEASE_APPROVER_PASSWORD: ${RELEASE_APPROVER_PASSWORD:?controller bootstrap secret missing RELEASE_APPROVER_PASSWORD}
      TF_PLAN_RECIPIENT: ${TF_PLAN_RECIPIENT:?controller bootstrap secret missing TF_PLAN_RECIPIENT}
    volumes:
      - {{ jenkins_host_data_mount }}/home:/var/jenkins_home
      - /etc/echoscript/jenkins/casc:/var/jenkins_config:ro
    networks: [jenkins]
    expose: [8080]
    security_opt: [no-new-privileges:true]
    read_only: true
    tmpfs: ["/tmp:rw,noexec,nosuid,size=256m"]
    healthcheck:
      test: [CMD, curl, --fail, --silent, http://127.0.0.1:8080/login]
      interval: 30s
      timeout: 5s
      retries: 5
  proxy:
    image: nginx:1.29.3-alpine
    container_name: echoscript-jenkins-proxy
    restart: unless-stopped
    ports: ["8443:8443"]
    volumes:
      - /etc/echoscript/jenkins/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ jenkins_host_data_mount }}/tls:/etc/nginx/certs:ro
    networks: [jenkins]
    depends_on: [jenkins]
    security_opt: [no-new-privileges:true]
networks:
  jenkins:
    name: echoscript-jenkins

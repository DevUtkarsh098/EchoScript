#!/usr/bin/env bash
set -euo pipefail
export DOCKER_CONFIG=/run/echoscript-jenkins-docker
registry=598391748654.dkr.ecr.us-west-2.amazonaws.com
case "${1:-login}" in
  login)
    install -d -m 0700 "$DOCKER_CONFIG"
    aws ecr get-login-password --region us-west-2 \
      | docker --config "$DOCKER_CONFIG" login --username AWS --password-stdin "$registry" >/dev/null
    ;;
  logout)
    docker --config "$DOCKER_CONFIG" logout "$registry" >/dev/null 2>&1 || true
    rm -f "$DOCKER_CONFIG/config.json"
    rmdir "$DOCKER_CONFIG" 2>/dev/null || true
    ;;
  *) exit 2 ;;
esac
